# Smart Agent API — provider configuration
# Copy to Backend/.env and fill in ONE provider's credentials.
#
#   LLM_PROVIDER: gemini (default) | groq | ollama | openrouter | cerebras
#
# Get keys:
#   Gemini  — https://aistudio.google.com/app/apikey   (free, ~20 req/day on some models)
#   Groq    — https://console.groq.com/keys            (free tier, very fast)
#   Ollama  — https://ollama.com                       (local, no key: `ollama pull llama3.1`)
#   OpenRouter — https://openrouter.ai/keys            (free models with :free suffix)
#   Cerebras   — https://cloud.cerebras.ai             (free tier)

# --- Provider selection ---
LLM_PROVIDER=gemini

# --- API keys (fill in only the one for your chosen provider) ---
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
# Ollama needs no key — it runs on your machine (default http://localhost:11434/v1).

# --- Model (optional; each provider has a sensible default) ---
# Gemini:   gemini-3.8-flash        Groq: qwen/qwen3.8-27b  (list: GET /openai/v1/models)
# Ollama:   llama3.1                OpenRouter: meta-llama/llama-3.3-70b-instruct
# Cerebras: llama-3.3-70b
# MODEL_NAME=

# --- Tuning (optional) ---
# MODEL_TEMPERATURE=0.0
# MODEL_REASONING_EFFORT=low
# AGENT_MAX_ITERATIONS=8
# RATE_LIMIT_PER_MINUTE=20
# MAX_MESSAGE_CHARS=4000
